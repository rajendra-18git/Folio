# ==============================================================================
# DocuMind AI Configuration
# ==============================================================================

# Google Gemini API Key (obtain from https://aistudio.google.com/)
# Optional for local test/demo mode; required for live grounded GenAI generation.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ==============================================================================
# Database Configuration (Supabase PostgreSQL + pgvector OR Local SQLite)
# ==============================================================================
# To use Supabase:
# 1. Go to your Supabase Project Dashboard -> Project Settings -> Database.
# 2. Copy the "Connection string" (URI) under "Transaction pooler" (port 6543) or "Direct connection" (port 5432).
# 3. Paste it below into DATABASE_URL (replace [YOUR-PASSWORD] with your database password):
#
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
#
# Optional Supabase API details:
# SUPABASE_URL=https://[your-project-ref].supabase.co
# SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Default local fallback (used if no Supabase URL is supplied):
DATABASE_URL=sqlite:///./data/documind.db

# Retrieval and Embedding
TOP_K_RETRIEVAL=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_FILE_SIZE_MB=25

# Frontend settings (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
