# ==============================================================================
# DocuMind AI Configuration
# ==============================================================================

# Google Gemini API Key (obtain from https://aistudio.google.com/)
# Optional for local test/demo mode; required for live grounded GenAI generation.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend server settings
DATABASE_URL=sqlite:///./data/documind.db
CHROMA_COLLECTION_NAME=documind_chunks
TOP_K_RETRIEVAL=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_FILE_SIZE_MB=25

# Frontend settings (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
